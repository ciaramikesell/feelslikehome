# Copy this file to .env.local and fill in the real values from your Supabase project.
# In GitHub Codespaces: right-click in the file explorer -> New File -> name it ".env.local",
# then paste your real values in (never commit .env.local — it's already in .gitignore).

# Supabase project URL
# Find it in Supabase: Project Settings -> Data API (or the "Connect" button on your project page)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Publishable key (current key type, replaces the older "anon public" key)
# Find it in Supabase: Project Settings -> API Keys -> "Publishable and secret API keys" tab
# It starts with sb_publishable_...
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Referrer-restricted browser key for Maps JavaScript API. The Map ID is
# optional (advanced markers/cloud styling); maps fall back to standard markers.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_referrer_restricted_browser_key
NEXT_PUBLIC_GOOGLE_MAP_ID=your_optional_google_map_id

# Server-only keys. Never prefix these with NEXT_PUBLIC_.
GOOGLE_GEOCODING_API_KEY=your_server_geocoding_key
GOOGLE_ROUTES_API_KEY=your_server_routes_key
