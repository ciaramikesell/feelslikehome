      "sdk": "@anthropic-ai/sdk@1.3.0"
    },
    {
      "id": "gemini-3-flash",
      "provider": "google",
      "model": "gemini-3-flash",
      "modelIdVerified": false,
      "enabled": false,
      "mediaResolution": "MEDIA_RESOLUTION_HIGH",
      "thinkingLevel": "LOW",
      "maxOutputTokens": 6000,
      "timeoutMs": 90000,
